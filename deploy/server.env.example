# Copy to deploy/server.env on the host and fill in. Consumed by
# deploy/compose.yml. DB_PATH / MEDIA_DIR / PORT are forced by compose.yml
# (they point at the persistent volume) — don't set them here.

# From @BotFather.
BOT_TOKEN=
BOT_USERNAME=watch2cpbot

# Numeric bot id (the part of BOT_TOKEN before the colon). Needed for the
# browser "Log in with Telegram" flow.
TELEGRAM_BOT_ID=
# Any long random string — signs the web session cookie. `openssl rand -hex 32`
SESSION_SECRET=

# Must be false in production (real initData validation).
DEV_SKIP_AUTH=false

# Frontend origin (the Cloudflare Worker's domain). The browser only ever
# talks to that Worker, which proxies to this server, so CORS is mostly moot
# — but set it rather than leaving "*".
CORS_ORIGIN=https://watch2cp-web.<your-workers-subdomain>.workers.dev

# Leave empty to run the bot on long polling (no inbound hostname needed).
# Set to this server's public origin (the cloudflared tunnel hostname) to
# switch the bot to a webhook.
PUBLIC_URL=

# Optional: in-app YouTube / web search tabs.
YOUTUBE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Download subsystem (yt-dlp + ffmpeg are baked into the image) ---
# Defaults are fine; override only if needed.
# MEDIA_MAX_TOTAL_BYTES=107374182400
# TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
