# Committed on purpose: a bot @username and its public numeric id are not
# secrets (anyone can see the bot). These are needed at BUILD time, and the
# Cloudflare Workers build has no access to the git-ignored .env.

# Empty: the Worker serves the frontend and proxies /api + /socket.io to the
# VPS on the same origin, so the client stays origin-relative (no CORS).
VITE_SERVER_URL=

VITE_BOT_USERNAME=watch2cpbot
VITE_TELEGRAM_BOT_ID=8835088148
