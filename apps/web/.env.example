# Leave unset to connect same-origin (works with the Vite dev proxy for
# /socket.io and with a single-hostname tunnel — see README). Only set this
# if the backend is reachable at a different origin than the frontend.
VITE_SERVER_URL=

# Your bot's @username (without the @), used to build the "Share room" deep
# link (https://t.me/<username>?startapp=room_XXXX). Leave unset in early
# local dev — the share button will just show a haptic error until it's set.
VITE_BOT_USERNAME=
