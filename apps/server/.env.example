# From @BotFather after /newbot. Required unless DEV_SKIP_AUTH=true.
BOT_TOKEN=

PORT=4000

# Origin(s) allowed to connect (your Vite dev URL or tunnel URL). "*" for local dev.
CORS_ORIGIN=*

# Skips initData HMAC validation so you can test the app before a real bot
# exists. Each connection gets a random throwaway identity. Never enable this
# in production.
DEV_SKIP_AUTH=true
