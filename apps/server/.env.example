# From @BotFather after /newbot. Required unless DEV_SKIP_AUTH=true.
# Also powers the DM bot that downloads a video from a link (or a file sent
# straight to it) — see apps/server/src/telegram/bot.ts.
BOT_TOKEN=

# Your bot's @username (without the @) — used server-side to build room
# invite links sent to friends via the Bot API.
BOT_USERNAME=

# Tunnel's public HTTPS origin (same one you point at localhost:5173 for the
# Mini App — see README), no trailing slash, e.g. https://your-tunnel.com.
# When set, the bot registers a Telegram webhook at PUBLIC_URL/telegram/webhook
# instead of long polling — Vite proxies that path through to the backend
# (see vite.config.ts), so no second tunnel is needed. Leave blank to fall
# back to long polling (no tunnel required).
PUBLIC_URL=

PORT=4000

# SQLite file for user profiles + friendships. Created automatically.
DB_PATH=./data/stream.db

# Origin(s) allowed to connect (your Vite dev URL or tunnel URL). "*" for local dev.
CORS_ORIGIN=*

# Skips initData HMAC validation so you can test the app before a real bot
# exists. Each connection gets a random throwaway identity. Never enable this
# in production.
DEV_SKIP_AUTH=true

# Powers the in-app YouTube search tab. Get a free key: console.cloud.google.com
# → create a project → "Enable APIs" → "YouTube Data API v3" → Credentials →
# Create API key. Free quota is ~100 searches/day. Leave blank to disable the tab.
YOUTUBE_API_KEY=

# Powers the "search other sites" tab (general web search). Needs two values
# from Google, both free:
#  1) GOOGLE_API_KEY — same Cloud Console project as above, "Enable APIs" →
#     "Custom Search API" → Credentials → Create API key.
#  2) GOOGLE_CSE_ID — go to programmablesearchengine.google.com → Add →
#     turn on "Search the entire web" → copy the "Search engine ID" (cx).
# Free quota is 100 searches/day. Leave either blank to disable the tab.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Where downloaded/imported video files live on disk. Created automatically.
MEDIA_DIR=./data/media

# Soft cap on total media-directory size in bytes — new downloads are refused
# once stored files exceed this. Default is 100 GiB (107374182400).
MEDIA_MAX_TOTAL_BYTES=107374182400

# Executables the download subsystem calls. Leave as-is to use PATH; set to an
# absolute path (or a venv shim) if PATH isn't reliable on the deploy host.
# yt-dlp is a Python tool installed separately (`pip install -U yt-dlp`) and
# should be refreshed on a schedule — site extractors break and get fixed
# upstream often. ffmpeg/ffprobe are used to remux non-HTML5-friendly
# containers (only when ffprobe says it's actually needed).
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Point at a self-hosted Local Bot API Server to lift the 20 MB getFile limit
# to 2000 MB — required for pulling full-quality videos sent straight to the
# bot as a file. Leave as the default to use Telegram's public API.
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Powers "Log in with Telegram" for people visiting the site directly in a
# browser (not inside Telegram) — see apps/server/src/telegram/validateTelegramLoginToken.ts.
# From @BotFather: your bot -> Bot Settings -> Web Login -> add your site's
# domain as an Allowed URL; BotFather then shows this numeric Client ID.
# Must match VITE_TELEGRAM_BOT_ID in apps/web/.env. Leave blank to disable the
# website login screen (Mini App usage is unaffected either way).
TELEGRAM_BOT_ID=

# Signs the session cookie issued after a successful browser Telegram Login
# (unrelated to BOT_TOKEN). Any long random string, e.g. `openssl rand -hex 32`.
# Required if TELEGRAM_BOT_ID is set. Rotating it logs out every web session.
SESSION_SECRET=
